{
  "$schema": "https://schemas.platformatic.dev/@platformatic/runtime/3.69.0.json",
  "entrypoint": "storage",
  "exitOnUnhandledErrors": false,
  "workers": "{WORKERS_NUM}",
  "messagingTimeout": 60000,
  "extensions": [
    {
      "path": "./dist/internal/monitoring/pprof/runtime-extension.js"
    }
  ],
  "logger": {
    "level": "{LOG_LEVEL}"
  },
  "health": {
    "enabled": "{WATT_HEALTH_ENABLED}",
    "maxELU": "{WATT_HEALTH_MAX_ELU}",
    "maxEventLoopDelayP99": "{WATT_HEALTH_MAX_EVENT_LOOP_DELAY_P99}",
    "gracePeriod": "{WATT_HEALTH_GRACE_PERIOD}",
    "maxUnhealthyChecks": "{WATT_HEALTH_MAX_UNHEALTHY_CHECKS}",
    "interval": "{WATT_HEALTH_INTERVAL}"
  },
  "managementApi": "{PLT_MANAGEMENT_API}",
  "management": {
    "operations": ["getWorkers"]
  },
  "applications": [
    {
      "id": "storage",
      "path": ".",
      "config": "watt.storage.json",
      "dependencies": ["database"],
      "env": {
        "DATABASE_WATT_APPLICATION_PRESENT": "true"
      }
    },
    {
      "id": "database",
      "path": ".",
      "config": "watt.database.json",
      "workers": "{DATABASE_WATT_WORKERS}",
      "health": {
        "maxELU": 1,
        "maxEventLoopDelay": 0,
        "maxEventLoopDelayP99": 0
      }
    }
  ]
}
